{
  "expo": {
    "name": "Candela",
    "slug": "candela",
    "version": "1.0.0",
    "scheme": "candela",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.elvagroup.candela",
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Candela uses the camera to control the light."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "package": "com.elvagroup.candela",
      "permissions": [
        "CAMERA",
        "FLASHLIGHT",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Candela uses the camera to control the light.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.elvagroup.candela",
          "enableGooglePay": false
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "db2f7db6-78e2-4c61-b455-18d63cc6815b"
      }
    },
    "owner": "xburrex"
  }
}
