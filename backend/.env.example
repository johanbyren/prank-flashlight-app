# Prefer a normal account key (sk_test_... / sk_live_...) from:
# https://dashboard.stripe.com/test/apikeys  or  /apikeys
#
# If you use an Organization key (sk_org_...), you MUST also set STRIPE_CONTEXT.

STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here

# Required only for Organization API keys (sk_org_...)
# Account ID looks like acct_...
# Dashboard → Settings → Account details (or Developers → account)
STRIPE_CONTEXT=acct_xxxxxxxxxxxxxxxx

# Optional: set to "live" when using sk_org_ with a live account
# STRIPE_MODE=live

# $19/month subscription Price ID (must match test/live mode of your keys)
STRIPE_PRICE_SUBSCRIPTION=price_xxxxxxxxxxxxxxxxxxxxxxxx

PORT=3000
